<?xml version="1.0" encoding="UTF-8"?>
<component name="fr.toutatice.ecm.platform.web.thumbnail.event.handler">

	<require>org.nuxeo.ecm.core.operation.OperationServiceComponent
	</require>

	<extension target="org.nuxeo.ecm.core.operation.OperationServiceComponent"
		point="event-handlers">

		<handler chainId="vignette-resizing">
			<event>documentCreated</event>
			<event>beforeDocumentModification</event>
			<filters>
				<condition>Document.hasSchema('toutatice') &amp;&amp; fr.toutatice.ecm.platform.service.fragments.configuration.ConfigurationBeanHelper.get().getWebsiteParamString("vignette_resizing", "true", Document.getDoc(), Document.getSession()) == "true"</condition>
				<attribute>Mutable Document</attribute>
			</filters>
		</handler>

	</extension>

</component>